# Copy to .env and fill in real values. .env is gitignored.
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Postgres connection string used by the backend and the celery workers (from ../infra: role/schema `autorev`).
AUTOREV_DATABASE_URL=postgresql://autorev:autorev@postgres:5432/appjs

# Token for the /setup page that creates the first admin. If unset, one is generated and printed
# in the backend log while no admin exists (`docker compose logs backend | grep "setup token"`).
# Remove it once setup is done.
# AUTOREV_SETUP_TOKEN=

# Payment gateways this server offers, comma-separated. `razorpay` alone runs Razorpay only: no PhonePe
# routes or scheduled tasks, and PhonePe can't be switched on for an app.
# AUTOREV_GATEWAYS=phonepe,razorpay

# Development only: allow outbound webhooks to private addresses (e.g. Studio at http://creative-api:8000
# on the Docker network). Never set this in production.
# AUTOREV_WEBHOOK_ALLOW_PRIVATE=true
