# Public sites, with automatic HTTPS (Let's Encrypt). Domains come from infra/.env. Each upstream is a
# network alias on the `appjs` network, set in that service's compose file.

{$APPJS_DOMAIN} {
	root * /srv/website
	try_files {path} /index.html
	file_server
}

{$STUDIO_DOMAIN} {
	reverse_proxy studio-web:80
}

{$STUDIO_API_DOMAIN} {
	reverse_proxy studio-api:8000
}

{$RESTYLE_DOMAIN} {
	reverse_proxy restyle-web:80
}

{$AUTOREV_DOMAIN} {
	reverse_proxy autorev-web:80
}
