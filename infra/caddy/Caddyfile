# Public sites, with automatic HTTPS (Let's Encrypt). Domains come from infra/.env. Each upstream is a
# network alias on the `appjs` network, set in that service's compose file.

{$APPJS_DOMAIN} {
	root * /srv/website
	try_files {path} {path}.html /index.html
	file_server
}

{$STUDIO_DOMAIN} {
	handle /api/* {
		uri replace /api/docs/oauth2-redirect /docs/oauth2-redirect
		uri strip_prefix /api
		reverse_proxy studio-api:8000
	}
	handle /openapi.json {
		reverse_proxy studio-api:8000
	}
	handle /api {
		redir /api/ 308
	}
	handle {
		reverse_proxy studio-web:80
	}
}

{$RESTYLE_DOMAIN} {
	reverse_proxy restyle-web:80
}

{$AUTOREV_DOMAIN} {
	handle /api/* {
		reverse_proxy autorev-api:8000
	}
	handle {
		reverse_proxy autorev-web:80
	}
}

# MarktMakrs: its own repo (github marktmakrs), checked out at ~/marktmakrs on the server. Upstreams are
# aliases on the marktmakrs-edge network (marktmakrs/deploy/docker-compose.edge.yml). Same routes as its
# old host nginx (marktmakrs/deploy/nginx/marktmakrs.conf). www is served too, not redirected:
# FRONTEND_ORIGIN there is https://www.marktmakrs.in. The /mcp rate limit is in the agent itself.
{$MARKTMAKRS_DOMAIN}, www.{$MARKTMAKRS_DOMAIN} {
	handle /api/* {
		reverse_proxy marktmakrs-api:8000 {
			transport http {
				read_timeout 600s
			}
		}
	}
	handle /mcp {
		reverse_proxy marktmakrs-agent:8100 {
			flush_interval -1
			transport http {
				read_timeout 120s
			}
		}
	}
	@docs path /docs /redoc /openapi.json
	handle @docs {
		reverse_proxy marktmakrs-api:8000
	}
	handle {
		reverse_proxy marktmakrs-web:80
	}
}
