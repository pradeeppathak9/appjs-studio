# Copy to .env (gitignored). Local development can keep these simple values; on a server use long
# random ones (openssl rand -hex 24) and APP_DB_CREATEDB=false.

# --- Postgres: superuser, and one login role per app (schema of the same name in database `appjs`)
POSTGRES_PASSWORD=postgres
STUDIO_DB_PASSWORD=studio
AUTOREV_DB_PASSWORD=autorev
# Development: let app roles create databases (studio's tests make throwaway ones). false on servers.
APP_DB_CREATEDB=true
# Passwords and roles are created on Postgres's first start. To change one later:
#   docker compose exec postgres /scripts/add-app.sh studio <new-password>

# --- Host ports, bound to 127.0.0.1 (the apps reach these over the `appjs` Docker network)
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# --- Servers: public domains for Caddy (`docker compose --profile edge up -d`)
# APPJS_DOMAIN=appjs.example.com
# STUDIO_DOMAIN=studio.example.com
# RESTYLE_DOMAIN=restyle.example.com
# AUTOREV_DOMAIN=autorev.example.com
# MarktMakrs (its own repo, not in this monorepo) also serves www.<domain>. Set it only at cutover,
# once DNS points here: before that Caddy's certificate requests for it fail and burn rate limit.
# MARKTMAKRS_DOMAIN=marktmakrs.in
