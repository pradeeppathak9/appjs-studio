# AppJs Studio on a server. Copy to .env next to docker-compose.prod.yaml (cp env.example .env) and fill in.
# Settings not listed here work as in ../.env.example (same names).

# --- Images and address -------------------------------------------------------------------------
STUDIO_IMAGE=ghcr.io/pradeeppathak9/appjs-studio-api
STUDIO_WEB_IMAGE=ghcr.io/pradeeppathak9/appjs-studio-web
TAG=latest                      # or a version you pushed, e.g. 2026-11-23
DOMAIN=studio.example.com       # DNS A record → this server; Caddy gets its HTTPS certificate

# --- Required secrets (each: openssl rand -hex 32) ----------------------------------------------
POSTGRES_PASSWORD=
# Encrypts credentials saved in the console (MSG91 key, apps' provider keys). Never change it after
# saving credentials: they become unreadable. Reuse your current one if you are moving a database.
SECRETS_KEY=
# Signs phone sign-in codes; must stay the same across restarts.
OTP_SECRET=
# For the /setup page that creates the first admin (https://DOMAIN/setup). Remove after setup.
SETUP_TOKEN=

# --- AI providers (server-wide; apps can also bring their own keys in App settings) -------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
OPENROUTER_API_KEY=
ENABLE_FAKE_PROVIDER=false

# --- App users' phone sign-in -------------------------------------------------------------------
SMS_PROVIDER=msg91              # never `log` in production
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# OTP_TEST_NUMBERS=+919999999999:123456   # store-review logins

# --- Optional -------------------------------------------------------------------------------------
# WORKER_CONCURRENCY=2
# LOG_LEVEL=INFO
