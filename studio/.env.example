# Copy to .env and fill in. Every setting is optional unless noted.

# --- Providers: each is enabled only when its key is set ---------------------------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
OPENROUTER_API_KEY=
# Which models each provider may use: creative/providers/fal.yaml and openrouter.yaml.
# Point at your own copies to change the list without rebuilding the image.
# FAL_MODELS_FILE=/app/config/fal.yaml
# OPENROUTER_MODELS_FILE=/app/config/openrouter.yaml
# Deterministic fake provider for local testing (no keys, no cost)
ENABLE_FAKE_PROVIDER=false
# DEFAULT_IMAGE_PROVIDER=gemini
# DEFAULT_VIDEO_PROVIDER=gemini

# --- First run ------------------------------------------------------------------------------
# Token for the /setup page that creates the first admin. If unset, one is generated and
# printed in the api log while no users exist (`docker compose logs api`).
# SETUP_TOKEN=

# --- Postgres (compose) -------------------------------------------------------------------------
# Postgres is shared, from ../infra: role `studio`, schema `studio` in database `appjs`.
# STUDIO_DB_PASSWORD must match ../infra/.env (default `studio` for development).
# STUDIO_DB_PASSWORD=studio
# Outside compose (uv run ...), the API and worker use:
# DATABASE_URL=postgresql://studio:studio@localhost:5432/appjs

# --- Ports on the host -------------------------------------------------------------------
# Bound to 127.0.0.1 unless you set *_BIND. WEB_BIND=0.0.0.0 opens the console to other
# machines (plain HTTP: passwords cross the network unencrypted until you add HTTPS).
# The API needs no outside port: the console reaches it through nginx.
# API_PORT=8010
# WEB_PORT=8080
# WEB_BIND=127.0.0.1
# API_BIND=127.0.0.1

# --- Files under ./data are owned by this uid/gid on the host -----------------------------
# UID=1000
# GID=1000

# --- Sessions: set COOKIE_SECURE=true once the site is served over HTTPS -----------------------
# COOKIE_SECURE=false
# SESSION_IDLE_HOURS=12
# SESSION_MAX_AGE_HOURS=168

# --- Worker -----------------------------------------------------------------------------------
# WORKER_CONCURRENCY=2
# JOB_MAX_ATTEMPTS=3
# JOB_TIMEOUT_IMAGE_S=180
# JOB_TIMEOUT_VIDEO_S=900

# --- App users: sign-in by SMS code, sessions ---------------------------------------------
# log = codes are written to the api log (development only); msg91 = send real SMS
# SMS_PROVIDER=log
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=          # a DLT-approved OTP template with a ##otp## variable
# OTP_SECRET=                 # set in production (any long random string); random per process when unset
# OTP_TEST_NUMBERS=           # store-review logins without SMS: +919999999999:123456,+15555550100:000000
# OTP_DEV_CODE=123456         # development: every phone code is this value (only with SMS_PROVIDER=log)
# DEFAULT_PHONE_COUNTRY_CODE=91
# Per app, the console (App settings → Sign-in) picks MSG91 or Firebase for phone codes, and can hold
# the app's own MSG91 auth key + template; the SMS_PROVIDER/MSG91_* above are the fallback for apps
# without their own. App settings → Provider API keys can also hold an app's own GOOGLE/OPENAI/FAL/
# OPENROUTER keys: its jobs use those, and the keys above only for providers it has none for.
# Credentials entered in the console are encrypted with SECRETS_KEY (any long random
# string, e.g. `openssl rand -hex 32`). Changing it makes saved credentials unreadable: enter them again.
# SECRETS_KEY=
# APP_SESSION_DAYS=90

# --- Webhooks -------------------------------------------------------------------------------------
# WEBHOOK_SECRET=
# ALLOW_PRIVATE_WEBHOOKS=false

# LOG_LEVEL=INFO
# LOG_PROMPTS=false
