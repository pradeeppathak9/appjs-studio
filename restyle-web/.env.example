# Development only (npm run dev). Copy to .env.local.
# The app key of the Studio app `restyle-ai` (Admin → Apps → Restyle → Keys). It ships in the page,
# like the one in the Android APK: an identifier, not a secret.
VITE_APP_KEY=cak_...
# Where `npm run dev` forwards /v1 (default http://localhost:8010)
# STUDIO_API=http://localhost:8010
